{
  "name": "@aws-sdk/lib-dynamodb-data-mapper",
  "version": "3.1005.0",
  "description": "Typed table mapping helpers for Amazon DynamoDB on top of DynamoDBDocumentClient.",
  "main": "./dist-cjs/index.js",
  "module": "./dist-es/index.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist-es/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "scripts": {
    "build": "concurrently 'yarn:build:types' 'yarn:build:es' && yarn build:cjs",
    "build:cjs": "node ../../scripts/compilation/inline lib-dynamodb-data-mapper",
    "build:es": "tsc -p tsconfig.es.json",
    "build:include:deps": "yarn g:turbo run build -F=\"$npm_package_name\"",
    "build:types": "tsc -p tsconfig.types.json",
    "build:types:downlevel": "downlevel-dts dist-types dist-types/ts3.4",
    "clean": "premove dist-cjs dist-es dist-types tsconfig.cjs.tsbuildinfo tsconfig.es.tsbuildinfo tsconfig.types.tsbuildinfo",
    "extract:docs": "tsc -p tsconfig.types.json && api-extractor run --local",
    "docs:markdown": "api-documenter markdown --input-folder ./temp --output-folder ./docs/api",
    "docs:api": "npm run extract:docs && npm run docs:markdown",
    "docs:serve": "mdts ./docs/api",
    "test": "yarn g:vitest run",
    "test:watch": "yarn g:vitest watch",
    "sample:demo": "tsx samples/demo.ts",
    "sample:seed": "tsx samples/seed.ts",
    "sample:inspect-local": "tsx samples/inspect-local.ts",
    "sample:bench": "tsx samples/micro-bench.ts",
    "sample:bench:minimal-query": "tsx samples/minimal-query-bench.ts",
    "sample:bench:minimal-query:measure": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/minimal-query-bench.ts --measure-only",
    "sample:bench:minimal-query:measure:n10": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 MINIMAL_QUERY_N_OPS_PER_ITER=10 tsx samples/minimal-query-bench.ts --measure-only",
    "sample:bench:minimal-query:measure:paired": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/minimal-query-bench.ts --measure-only --paired",
    "sample:bench:minimal-query:measure:paired:n10": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 MINIMAL_QUERY_N_OPS_PER_ITER=10 tsx samples/minimal-query-bench.ts --measure-only --paired",
    "sample:bench:minimal-query:aws": "tsx samples/minimal-query-bench.ts --with-aws",
    "sample:bench:compare:aws": "tsx samples/micro-bench-comparison.ts --with-aws",
    "sample:bench:workflow": "tsx samples/bench-workflow.ts",
    "sample:bench:workflow:full": "tsx samples/bench-workflow.ts -- --phase=full",
    "sample:bench:workflow:tuned-local": "tsx samples/bench-workflow.ts -- --phase=tuned-local",
    "sample:bench:compare:paired-local:tuned": "MICRO_BENCH_WARMUP_MS=3000 MICRO_BENCH_MEASURE_MS=15000 MICRO_BENCH_REPEATS=10 MICRO_BENCH_GC=1 AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 node --expose-gc ./node_modules/tsx/dist/cli.mjs samples/micro-bench-comparison.ts --paired-with-local --paired-order=alternate --repeats=10",
    "sample:bench:compare": "tsx samples/micro-bench-comparison.ts",
    "sample:bench:compare:measure": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/micro-bench-comparison.ts --measure-only",
    "sample:bench:compare:measure:cold": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/micro-bench-comparison.ts --measure-only --cold-client",
    "sample:bench:compare:measure:ms": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/micro-bench-comparison.ts --measure-only --ms",
    "sample:bench:compare:breakdown": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/micro-bench-comparison.ts --measure-only --breakdown",
    "sample:bench:compare:paired": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/micro-bench-comparison.ts --measure-only --breakdown --paired-breakdown",
    "sample:bench:compare:paired:repeats": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/micro-bench-comparison.ts --measure-only --breakdown --paired-breakdown --paired-order=alternate --repeats=5",
    "sample:bench:compare:local:cold": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/micro-bench-comparison.ts --with-local --cold-client",
    "sample:bench:compare:paired-local": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/micro-bench-comparison.ts --paired-with-local",
    "sample:bench:compare:paired-local:repeats": "AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 tsx samples/micro-bench-comparison.ts --paired-with-local --paired-order=alternate --repeats=5",
    "sample:bench:compare:cpu-prof": "mkdir -p .cpu-prof && AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 node --cpu-prof --cpu-prof-dir=./.cpu-prof --cpu-prof-name=micro-bench-compare-measure-only ./node_modules/tsx/dist/cli.mjs samples/micro-bench-comparison.ts --measure-only",
    "sample:bench:cpu-prof-harness": "mkdir -p cpu-prof && AWS_SDK_JS_SUPPRESS_MAINTENANCE_MODE_MESSAGE=1 node --cpu-prof --cpu-prof-interval=250 --cpu-prof-dir=./cpu-prof --cpu-prof-name=cpu-prof-harness ./node_modules/tsx/dist/cli.mjs samples/cpu-prof-harness.ts",
    "test:e2e": "yarn g:vitest run -c vitest.config.e2e.mts --mode development",
    "test:e2e:watch": "yarn g:vitest watch -c vitest.config.e2e.mts",
    "test:integration": "yarn g:vitest run -c vitest.config.integ.mts --mode development",
    "test:integration:watch": "yarn g:vitest watch -c vitest.config.integ.mts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": {
    "name": "AWS SDK for JavaScript Team",
    "url": "https://aws.amazon.com/javascript/"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "workspace:^3.1005.0",
    "@aws-sdk/lib-dynamodb": "workspace:^3.1005.0"
  },
  "devDependencies": {
    "@smithy/smithy-client": "^4.12.3",
    "@aws-sdk/client-dynamodb": "workspace:3.1005.0",
    "@aws-sdk/lib-dynamodb": "workspace:3.1005.0",
    "@microsoft/api-documenter": "^7.30.5",
    "@tsconfig/recommended": "1.0.13",
    "@types/node": "^25.6.0",
    "aws-sdk": "^2.1693.0",
    "concurrently": "9.2.1",
    "downlevel-dts": "0.11.0",
    "dynamodb-toolbox": "2.8.0",
    "dynamoose": "^4.1.5",
    "electrodb": "^3.7.5",
    "mdts": "^0.20.0",
    "premove": "4.0.0",
    "tinybench": "^6.0.0",
    "tsx": "4.21.0",
    "typescript": "~6.0.3"
  },
  "typesVersions": {
    "<4.5": {
      "dist-types/*": [
        "dist-types/ts3.4/*"
      ]
    }
  },
  "files": [
    "dist-*/**"
  ],
  "homepage": "https://github.com/aws/aws-sdk-js-v3/tree/main/lib/lib-dynamodb-data-mapper",
  "repository": {
    "type": "git",
    "url": "https://github.com/aws/aws-sdk-js-v3.git",
    "directory": "lib/lib-dynamodb-data-mapper"
  }
}
